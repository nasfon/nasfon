---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'web-development' } },
    { params: { slug: 'mobile-development' } },
    { params: { slug: 'saas-development' } },
    { params: { slug: 'api-development' } },
    { params: { slug: 'cloud-devops' } },
    { params: { slug: 'mvp-development' } },
  ];
}

const { slug } = Astro.params;

const allServices = [
  { slug: 'web-development', title: 'Web Applications' },
  { slug: 'mobile-development', title: 'Mobile Applications' },
  { slug: 'saas-development', title: 'SaaS Products' },
  { slug: 'api-development', title: 'API & Integration' },
  { slug: 'cloud-devops', title: 'Cloud & DevOps' },
  { slug: 'mvp-development', title: 'MVP Development' },
];

const otherServices = allServices.filter(s => s.slug !== slug);

const serviceData: Record<string, { title: string; description: string; features: string[]; metaTitle: string; metaDescription: string }> = {
  'web-development': {
    title: 'Web Applications',
    description: 'We design and build custom web applications that deliver exceptional performance, scalability, and user experience. From complex enterprise platforms to sleek consumer-facing products, our team crafts solutions that grow with your business.',
    features: ['Custom React/Next.js & Vue applications', 'Progressive Web Apps (PWAs)', 'E-commerce platforms', 'Real-time dashboards & admin panels', 'Performance optimization & SEO', 'Responsive, accessible design'],
    metaTitle: 'Web Development Services | NasFon',
    metaDescription: 'Custom web application development by NasFon — React, Next.js, Vue, PWAs, e-commerce platforms, and scalable web solutions for businesses in Nigeria.',
  },
  'mobile-development': {
    title: 'Mobile Applications',
    description: 'Native and cross-platform mobile apps that feel right at home on every device. We build apps that users love — fast, intuitive, and reliable.',
    features: ['iOS & Android native development', 'React Native & Flutter cross-platform', 'UI/UX design for mobile', 'Push notifications & offline support', 'App Store submission & optimization', 'Ongoing maintenance & updates'],
    metaTitle: 'Mobile App Development | NasFon',
    metaDescription: 'Native and cross-platform mobile app development by NasFon — iOS, Android, React Native, and Flutter apps for businesses in Nigeria.',
  },
  'saas-development': {
    title: 'SaaS Products',
    description: 'End-to-end SaaS product development — from validated MVP to full-scale subscription platform. We handle architecture, billing, multi-tenancy, and everything in between.',
    features: ['Multi-tenant architecture', 'Subscription & billing integration', 'User management & authentication', 'Analytics & reporting dashboards', 'API-first design', 'Scalable cloud infrastructure'],
    metaTitle: 'SaaS Product Development | NasFon',
    metaDescription: 'SaaS product development by NasFon — multi-tenant architecture, subscription billing, user management, and scalable cloud platforms.',
  },
  'api-development': {
    title: 'API & Integration',
    description: 'Robust, well-documented APIs that power your products and connect your systems. We design APIs that are reliable, secure, and built to scale.',
    features: ['RESTful & GraphQL API design', 'Third-party API integrations', 'Payment gateway integration', 'Authentication & authorization', 'API documentation & SDKs', 'Rate limiting & monitoring'],
    metaTitle: 'API Development & Integration | NasFon',
    metaDescription: 'API development and integration services by NasFon — RESTful APIs, GraphQL, third-party integrations, payment gateways, and system connectivity.',
  },
  'cloud-devops': {
    title: 'Cloud & DevOps',
    description: 'Cloud infrastructure and deployment automation that keeps your applications running smoothly. We set up the foundations for reliable, scalable operations.',
    features: ['AWS, GCP & Azure infrastructure', 'CI/CD pipeline setup', 'Docker & Kubernetes', 'Infrastructure as Code (Terraform)', 'Monitoring & alerting', 'Cost optimization'],
    metaTitle: 'Cloud Infrastructure & DevOps | NasFon',
    metaDescription: 'Cloud infrastructure and DevOps services by NasFon — AWS, GCP, Azure, CI/CD pipelines, Docker, Kubernetes, and infrastructure automation.',
  },
  'mvp-development': {
    title: 'MVP Development',
    description: 'Turn your idea into a working product fast. We build focused, validated MVPs that help you test the market and attract investors — without cutting corners on quality.',
    features: ['Rapid prototyping & validation', 'Core feature identification', 'Agile sprint-based delivery', 'User testing & feedback loops', 'Investor-ready demos', 'Path to full product'],
    metaTitle: 'MVP Development Services | NasFon',
    metaDescription: 'MVP development by NasFon — rapid prototyping, agile delivery, user testing, and investor-ready products to validate your business idea.',
  },
};

const current = serviceData[slug!] || serviceData['web-development'];

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": current.title,
  "description": current.description,
  "url": `https://nasfon.com/services/${slug}/`,
  "provider": {
    "@type": "Organization",
    "name": "NasFon Nig Ltd",
    "url": "https://nasfon.com"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Nigeria"
  },
  "serviceType": current.title
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://nasfon.com" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://nasfon.com/services/" },
    { "@type": "ListItem", "position": 3, "name": current.title, "item": `https://nasfon.com/services/${slug}/` }
  ]
};
---
<BaseLayout title={current.metaTitle} description={current.metaDescription} jsonLd={[serviceJsonLd, breadcrumbJsonLd]}>
    <Nav />

    <section class="page-hero">
        <div class="hero-bg-grid"></div>
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div>
            <h1>{current.title}</h1>
            <p>{current.description.slice(0, 120)}...</p>
        </div>
    </section>

    <section class="service-detail">
        <div class="service-detail-grid">
            <div class="service-detail-content reveal">
                <h2>{current.title}</h2>
                <p>{current.description}</p>
                <ul class="service-detail-features">
                    {current.features.map(feature => (
                        <li>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            {feature}
                        </li>
                    ))}
                </ul>
                <div style="margin-top: 32px;">
                    <a href="/contact/" class="btn-primary">
                        Start Your Project
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                </div>
            </div>
            <div class="service-detail-sidebar reveal">
                <h3>Other Services</h3>
                <ul class="related-list">
                    {otherServices.map(s => (
                        <li>
                            <a href={`/services/${s.slug}/`}>
                                {s.title}
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>

    <Footer />
</BaseLayout>
