---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "NasFon — We Build Software People Trust";
const pageDescription = "NasFon is a technology company in Nigeria that builds reliable web applications, mobile apps, SaaS products, APIs, and cloud solutions for businesses and startups.";

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "NasFon Nig Ltd",
  "alternateName": "NasFon",
  "url": "https://nasfon.com",
  "logo": "https://nasfon.com/logo.png",
  "description": "NasFon designs, builds, and scales innovative digital solutions — web apps, mobile apps, SaaS products, APIs, and cloud infrastructure for businesses and startups.",
  "founders": [
    {
      "@type": "Person",
      "name": "Nasir Musa"
    },
    {
      "@type": "Person",
      "name": "Shamsudeen Yusuf"
    }
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Tella",
    "addressRegion": "Taraba State",
    "addressCountry": "NG"
  },
  "areaServed": {
    "@type": "Country",
    "name": "Nigeria"
  },
  "sameAs": [
    "https://www.linkedin.com/company/nasfoncampany",
    "https://www.facebook.com/nasfoncampany",
    "https://www.instagram.com/nasfoncampany",
    "https://www.youtube.com/@nasfoncompany"
  ]
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "NasFon",
  "url": "https://nasfon.com",
  "description": "We Build Software People Trust. Technology company building web apps, mobile apps, SaaS products, and cloud solutions in Nigeria.",
  "publisher": {
    "@type": "Organization",
    "name": "NasFon Nig Ltd",
    "logo": {
      "@type": "ImageObject",
      "url": "https://nasfon.com/logo.png"
    }
  }
};
---
<BaseLayout title={pageTitle} description={pageDescription} jsonLd={[organizationJsonLd, websiteJsonLd]}>
    <Nav />

    <!-- Hero -->
    <section class="hero">
        <div class="hero-bg-grid"></div>
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>

        <div class="hero-content">
            <div class="hero-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                Trusted Technology Partner
            </div>
            <h1>We Build Software<br>People <span class="highlight">Trust</span></h1>
            <p>NasFon designs, builds, and scales innovative digital solutions for businesses, startups, and organizations. We turn ideas into reliable, impactful products.</p>
            <div class="hero-buttons">
                <a href="/apply/" class="btn-primary">
                    Start Your Project
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                <a href="/services/" class="btn-secondary">Our Services</a>
            </div>

            <a href="/dangote-ipo/index.html" class="ipo-banner" aria-label="Learn more about the Dangote Refinery IPO community awareness session">
                <span class="ipo-banner-shine"></span>
                <span class="ipo-banner-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><path d="M6 20V9l4-3 4 3v11"/><path d="M14 20v-6h4v6"/><path d="M9 11h.01"/><path d="M9 14h.01"/><path d="M17 11v3"/></svg>
                </span>
                <span class="ipo-banner-body">
                    <span class="ipo-banner-tag">
                        <span class="ipo-pulse"></span>
                        Community Awareness Session
                    </span>
                    <span class="ipo-banner-title">Understanding the <span class="ipo-gold">Dangote Refinery IPO</span></span>
                    <span class="ipo-banner-text">A free educational session on how IPOs work, how to invest through licensed channels, and how to avoid scams.</span>
                </span>
                <span class="ipo-banner-cta">
                    Learn more about the Dangote IPO
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </span>
            </a>

            <div class="hero-visual">
                <div class="hero-code-window">
                    <div class="code-header">
                        <div class="code-dot r"></div>
                        <div class="code-dot y"></div>
                        <div class="code-dot g"></div>
                        <span>nasfon.js</span>
                    </div>
                    <div class="code-body" id="codeBody">
                        <div class="code-line"><span class="code-comment">// We design, build, and scale</span></div>
                        <div class="code-line"><span class="code-keyword">const</span> <span class="code-func">nasfon</span> <span class="code-operator">=</span> <span class="code-bracket">&#123;</span></div>
                        <div class="code-line">&nbsp;&nbsp;purpose: <span class="code-string">"Build software people trust"</span>,</div>
                        <div class="code-line">&nbsp;&nbsp;approach: <span class="code-string">"Long-term partnership"</span>,</div>
                        <div class="code-line">&nbsp;&nbsp;standard: <span class="code-string">"Excellence, always"</span>,</div>
                        <div class="code-line">&nbsp;&nbsp;deliver: <span class="code-func">()</span> <span class="code-operator">=&gt;</span> <span class="code-string">"Impactful digital products"</span></div>
                        <div class="code-line"><span class="code-bracket">&#125;</span>;</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Trusted By -->
    <div class="trusted reveal">
        <p>Trusted by forward-thinking companies</p>
        <div class="trusted-logos">
            <svg viewBox="0 0 120 28" fill="currentColor"><text x="0" y="20" font-family="Inter" font-size="18" font-weight="700">Acme</text></svg>
            <svg viewBox="0 0 120 28" fill="currentColor"><text x="0" y="20" font-family="Inter" font-size="18" font-weight="700">TechFlow</text></svg>
            <svg viewBox="0 0 120 28" fill="currentColor"><text x="0" y="20" font-family="Inter" font-size="18" font-weight="700">NovaLab</text></svg>
            <svg viewBox="0 0 120 28" fill="currentColor"><text x="0" y="20" font-family="Inter" font-size="18" font-weight="700">CloudBase</text></svg>
            <svg viewBox="0 0 120 28" fill="currentColor"><text x="0" y="20" font-family="Inter" font-size="18" font-weight="700">Innovate</text></svg>
            <svg viewBox="0 0 120 28" fill="currentColor"><text x="0" y="20" font-family="Inter" font-size="18" font-weight="700">Acme</text></svg>
            <svg viewBox="0 0 120 28" fill="currentColor"><text x="0" y="20" font-family="Inter" font-size="18" font-weight="700">TechFlow</text></svg>
            <svg viewBox="0 0 120 28" fill="currentColor"><text x="0" y="20" font-family="Inter" font-size="18" font-weight="700">NovaLab</text></svg>
            <svg viewBox="0 0 120 28" fill="currentColor"><text x="0" y="20" font-family="Inter" font-size="18" font-weight="700">CloudBase</text></svg>
            <svg viewBox="0 0 120 28" fill="currentColor"><text x="0" y="20" font-family="Inter" font-size="18" font-weight="700">Innovate</text></svg>
        </div>
    </div>

    <!-- Services -->
    <section class="services" id="services">
        <div class="section-header reveal">
            <div class="section-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                What We Do
            </div>
            <h2>End-to-End Digital Product Development</h2>
            <p>From strategy to deployment, we partner with you to build technology that creates lasting value.</p>
        </div>

        <div class="services-grid">
            <a href="/services/web-development/" class="service-card reveal">
                <div class="service-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </div>
                <h3>Web Applications</h3>
                <p>Custom-built web platforms designed for performance, scalability, and exceptional user experiences.</p>
            </a>
            <a href="/services/mobile-development/" class="service-card reveal">
                <div class="service-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18"/></svg>
                </div>
                <h3>Mobile Applications</h3>
                <p>Native and cross-platform mobile apps that deliver seamless experiences on every device.</p>
            </a>
            <a href="/services/saas-development/" class="service-card reveal">
                <div class="service-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <h3>SaaS Products</h3>
                <p>Complete SaaS product development from MVP to full-scale, subscription-ready platforms.</p>
            </a>
            <a href="/services/api-development/" class="service-card reveal">
                <div class="service-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                </div>
                <h3>API & Integration</h3>
                <p>Robust API design, development, and seamless third-party system integrations.</p>
            </a>
            <a href="/services/cloud-devops/" class="service-card reveal">
                <div class="service-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                </div>
                <h3>Cloud & DevOps</h3>
                <p>Cloud infrastructure setup, deployment automation, and continuous delivery pipelines.</p>
            </a>
            <a href="/services/mvp-development/" class="service-card reveal">
                <div class="service-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 0 1 10 10c0 5.52-4.48 10-10 10S2 17.52 2 12 6.48 2 12 2z"/><path d="M12 6v6l4 2"/></svg>
                </div>
                <h3>MVP Development</h3>
                <p>Rapid, focused MVP builds to validate your idea and enter the market with confidence.</p>
            </a>
            <a href="/services/web-development/" class="service-card reveal">
                <div class="service-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                </div>
                <h3>Software Architecture</h3>
                <p>Scalable, maintainable architecture designed for long-term growth and reliability.</p>
            </a>
            <a href="/services/web-development/" class="service-card reveal">
                <div class="service-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                </div>
                <h3>Modernization</h3>
                <p>Legacy system modernization and re-engineering for better performance and maintainability.</p>
            </a>
            <a href="/services/web-development/" class="service-card reveal">
                <div class="service-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h3>Security & Support</h3>
                <p>Ongoing maintenance, security hardening, and long-term support for your digital products.</p>
            </a>
        </div>
    </section>

    <!-- Values -->
    <section id="values">
        <div class="section-header reveal">
            <div class="section-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                Our Values
            </div>
            <h2>What Guides Every Decision</h2>
            <p>Our core values shape how we build products, serve clients, and grow as a team.</p>
        </div>

        <div class="values-grid">
            <div class="value-card reveal"><div class="value-num">01</div><h3>Excellence</h3></div>
            <div class="value-card reveal"><div class="value-num">02</div><h3>Integrity</h3></div>
            <div class="value-card reveal"><div class="value-num">03</div><h3>Innovation</h3></div>
            <div class="value-card reveal"><div class="value-num">04</div><h3>Simplicity</h3></div>
            <div class="value-card reveal"><div class="value-num">05</div><h3>Partnership</h3></div>
            <div class="value-card reveal"><div class="value-num">06</div><h3>Reliability</h3></div>
            <div class="value-card reveal"><div class="value-num">07</div><h3>Continuous Improvement</h3></div>
            <div class="value-card reveal"><div class="value-num">08</div><h3>Customer Success</h3></div>
        </div>
    </section>

    <!-- Stats -->
    <section class="stats">
        <div class="stats-grid">
            <div class="stat-item reveal">
                <div class="stat-num" data-target="2"><span class="blue">0</span></div>
                <div class="stat-label">Live Products</div>
            </div>
            <div class="stat-item reveal">
                <div class="stat-num" data-target="30"><span class="blue">0</span>+</div>
                <div class="stat-label">Happy Clients</div>
            </div>
            <div class="stat-item reveal">
                <div class="stat-num" data-target="99"><span class="blue">0</span>%</div>
                <div class="stat-label">Client Satisfaction</div>
            </div>
            <div class="stat-item reveal">
                <div class="stat-num" data-target="24"><span class="blue">0</span>/7</div>
                <div class="stat-label">Support Available</div>
            </div>
        </div>
    </section>

    <!-- Process -->
    <section id="process">
        <div class="section-header reveal">
            <div class="section-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                Our Process
            </div>
            <h2>From Idea to Impact</h2>
            <p>A proven process that transforms your vision into a reliable, scalable digital product.</p>
        </div>

        <div class="process-steps">
            <div class="process-step">
                <div class="step-marker">1</div>
                <div class="step-content">
                    <h3>Discovery & Strategy</h3>
                    <p>We start by understanding your business goals, users, and market to define the right product strategy.</p>
                </div>
            </div>
            <div class="process-step">
                <div class="step-marker">2</div>
                <div class="step-content">
                    <h3>Design & Prototype</h3>
                    <p>Intuitive UI/UX design with interactive prototypes that bring your product vision to life before code.</p>
                </div>
            </div>
            <div class="process-step">
                <div class="step-marker">3</div>
                <div class="step-content">
                    <h3>Build & Test</h3>
                    <p>Agile development with continuous testing, code reviews, and transparent progress updates.</p>
                </div>
            </div>
            <div class="process-step">
                <div class="step-marker">4</div>
                <div class="step-content">
                    <h3>Deploy & Scale</h3>
                    <p>Production-ready deployment with infrastructure optimization and ongoing performance monitoring.</p>
                </div>
            </div>
            <div class="process-step">
                <div class="step-marker">5</div>
                <div class="step-content">
                    <h3>Support & Evolve</h3>
                    <p>Long-term partnership with continuous improvements, updates, and dedicated support.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonial -->
    <section class="testimonial-section">
        <div class="section-header reveal">
            <div class="section-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Our Promise
            </div>
            <h2>Built on Trust</h2>
        </div>
        <div class="testimonial-card reveal">
            <div class="quote-mark">"</div>
            <p>Technology changes every day. Trust lasts. We choose honesty over shortcuts, quality over speed, and long-term relationships over short-term success.</p>
            <div class="testimonial-author">The NasFon Team</div>
            <div class="testimonial-role">Committed to building software people trust and are proud to use</div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta-section" id="contact">
        <div class="cta-box reveal">
            <h2>Ready to Build Something Great?</h2>
            <p>Let's turn your idea into a reliable, scalable digital product that creates lasting value.</p>
            <div class="cta-buttons">
                <a href="mailto:hello@nasfon.com" class="btn-white">
                    Get in Touch
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                <a href="/services/" class="btn-outline-white">Explore Services</a>
            </div>
        </div>
    </section>

    <Footer />
</BaseLayout>
