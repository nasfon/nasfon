---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "About NasFon | Technology & Software Development Company";
const pageDescription = "Learn about NasFon Nig Ltd — a technology company in Tella, Taraba State, Nigeria building reliable software, web apps, mobile apps, and SaaS products.";

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About NasFon",
  "description": "Learn about NasFon Nig Ltd — a technology company in Tella, Taraba State, Nigeria building reliable software, web apps, mobile apps, and SaaS products.",
  "url": "https://nasfon.com/about/",
  "mainEntity": {
    "@type": "Organization",
    "name": "NasFon Nig Ltd",
    "alternateName": "NasFon",
    "url": "https://nasfon.com",
    "description": "NasFon designs, builds, and scales innovative digital solutions for businesses, startups, and organizations in Nigeria and beyond.",
    "founders": [
      {
        "@type": "Person",
        "name": "Nasir Musa",
        "jobTitle": "CEO & Co-Founder"
      },
      {
        "@type": "Person",
        "name": "Shamsudeen Yusuf",
        "jobTitle": "CTO & Co-Founder"
      }
    ],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Tella",
      "addressRegion": "Taraba State",
      "addressCountry": "NG"
    },
    "areaServed": {
      "@type": "Country",
      "name": "Nigeria"
    }
  }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://nasfon.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "About",
      "item": "https://nasfon.com/about/"
    }
  ]
};
---
<BaseLayout title={pageTitle} description={pageDescription} jsonLd={[aboutJsonLd, breadcrumbJsonLd]}>
    <Nav />

    <section class="page-hero">
        <div class="hero-bg-grid"></div>
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div>
            <h1>About NasFon</h1>
            <p>The people behind NasFon — building software people trust.</p>
        </div>
    </section>

    <section>
        <div class="section-header reveal">
            <div class="section-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                Our Story
            </div>
            <h2>Why NasFon Exists</h2>
            <p>NasFon was founded with a simple mission: to build software people trust. We believe technology should be reliable, impactful, and built with integrity.</p>
        </div>
    </section>

    <section>
        <div class="section-header reveal">
            <div class="section-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Leadership
            </div>
            <h2>Meet the Founders</h2>
            <p>The people driving NasFon's vision and technical excellence.</p>
        </div>

        <div class="founders-grid">
            <div class="founder-card reveal">
                <div class="founder-avatar">
                    <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect width="120" height="120" rx="60" fill="#e8f1ff"/>
                        <circle cx="60" cy="45" r="20" fill="#1a6bff" opacity="0.8"/>
                        <ellipse cx="60" cy="95" rx="32" ry="24" fill="#1a6bff" opacity="0.6"/>
                    </svg>
                </div>
                <h3>Nasir Musa</h3>
                <span class="founder-role">CEO & Co-Founder</span>
                <p class="founder-location">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    Taraba State, Nigeria
                </p>
                <p class="founder-bio">Driving NasFon's vision and strategy. Nasir leads the company's mission to build software people trust while forging long-term partnerships with clients across industries.</p>
                <div class="founder-socials">
                    <a href="https://www.linkedin.com/in/nasirmusap" target="_blank" rel="noopener" aria-label="LinkedIn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </a>
                    <a href="https://www.instagram.com/nasirmusap" target="_blank" rel="noopener" aria-label="Instagram">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                    </a>
                </div>
            </div>

            <div class="founder-card reveal">
                <div class="founder-avatar">
                    <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect width="120" height="120" rx="60" fill="#e8f1ff"/>
                        <circle cx="60" cy="45" r="20" fill="#1a6bff" opacity="0.8"/>
                        <ellipse cx="60" cy="95" rx="32" ry="24" fill="#1a6bff" opacity="0.6"/>
                    </svg>
                </div>
                <h3>Shamsudeen Yusuf</h3>
                <span class="founder-role">CTO & Co-Founder</span>
                <p class="founder-location">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    Kaduna State, Nigeria
                </p>
                <p class="founder-bio">Leading NasFon's technical vision and engineering excellence. Shamsudeen ensures every product built meets the highest standards of quality, security, and scalability.</p>
                <div class="founder-socials">
                    <a href="https://www.linkedin.com/in/shamsuddeiin" target="_blank" rel="noopener" aria-label="LinkedIn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.
771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section id="values">
        <div class="section-header reveal">
            <div class="section-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                Our Values
            </div>
            <h2>What Guides Every Decision</h2>
            <p>Our core values shape how we build products, serve clients, and grow as a team.</p>
        </div>

        <div class="values-grid">
            <div class="value-card reveal"><div class="value-num">01</div><h3>Excellence</h3></div>
            <div class="value-card reveal"><div class="value-num">02</div><h3>Integrity</h3></div>
            <div class="value-card reveal"><div class="value-num">03</div><h3>Innovation</h3></div>
            <div class="value-card reveal"><div class="value-num">04</div><h3>Simplicity</h3></div>
            <div class="value-card reveal"><div class="value-num">05</div><h3>Partnership</h3></div>
            <div class="value-card reveal"><div class="value-num">06</div><h3>Reliability</h3></div>
            <div class="value-card reveal"><div class="value-num">07</div><h3>Continuous Improvement</h3></div>
            <div class="value-card reveal"><div class="value-num">08</div><h3>Customer Success</h3></div>
        </div>
    </section>

    <section class="cta-section">
        <div class="cta-box reveal">
            <h2>Want to Work With Us?</h2>
            <p>We're always looking for great partners and clients who value quality and trust.</p>
            <div class="cta-buttons">
                <a href="mailto:hello@nasfon.com" class="btn-white">
                    Get in Touch
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                <a href="/services/" class="btn-outline-white">Explore Services</a>
            </div>
        </div>
    </section>

    <Footer />
</BaseLayout>
