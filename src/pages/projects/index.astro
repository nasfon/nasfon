---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const pageTitle = "Software Projects & Case Studies | NasFon";
const pageDescription = "Explore live software products built by NasFon — an inventory management system and an online marketplace serving businesses in Nigeria.";

const projectsJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "NasFon Software Projects",
  "description": "Live software products and platforms built by NasFon.",
  "url": "https://nasfon.com/projects/",
  "numberOfItems": 2,
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inventory OS",
      "url": "https://nasfon.com/projects/inventory-os/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "NasFon Market",
      "url": "https://nasfon.com/projects/nasfon-market/"
    }
  ]
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://nasfon.com" },
    { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://nasfon.com/projects/" }
  ]
};

const projects = [
  {
    slug: 'inventory-os',
    title: 'Inventory OS',
    tag: 'Inventory Management',
    desc: 'A complete inventory and sales management system for retail and wholesale businesses — tracking products, customers, sales, expenses, and credit with real-time dashboards.',
    thumb: '/projects/inventory-dashboard.png',
    live: 'https://inventory-gamma-six-17.vercel.app/',
  },
  {
    slug: 'nasfon-market',
    title: 'NasFon Market',
    tag: 'E-Commerce',
    desc: 'An online marketplace for electronics and everyday products, with search, cart, secure checkout, customer accounts, and order management.',
    thumb: '/projects/market-homepage.png',
    live: 'https://market.nasfon.com/',
  },
];
---
<BaseLayout title={pageTitle} description={pageDescription} jsonLd={[projectsJsonLd, breadcrumbJsonLd]}>
    <Nav />

    <section class="page-hero">
        <div class="hero-bg-grid"></div>
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div>
            <h1>Our Projects</h1>
            <p>Explore the products and platforms we've built for clients and ourselves.</p>
        </div>
    </section>

    <section>
        <div class="projects-grid">
            {projects.map(project => (
                <a href={`/projects/${project.slug}/`} class="project-card reveal">
                    <div class="project-thumb">
                        <img src={project.thumb} alt={`${project.title} — screenshot`} width="1349" height="610" loading="lazy" decoding="async">
                        <span class="project-live-badge"><span class="ipo-pulse"></span> Live</span>
                    </div>
                    <div class="project-info">
                        <span class="project-tag">{project.tag}</span>
                        <h3>{project.title}</h3>
                        <p>{project.desc}</p>
                        <span class="project-link">
                            View case study
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </span>
                    </div>
                </a>
            ))}
        </div>
    </section>

    <Footer />
</BaseLayout>
