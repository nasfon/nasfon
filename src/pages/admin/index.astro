---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { db, ensureTablesCreated } from '../../db';
import { contactSubmissions, projectApplications } from '../../db/schema';
import { desc } from 'drizzle-orm';
import { isValidAdminSession } from '../../lib/auth';

export const prerender = false;

// 1. Authenticate session
if (!isValidAdminSession(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

// 2. Fetch live data from Turso
await ensureTablesCreated();

const applications = await db.select().from(projectApplications).orderBy(desc(projectApplications.createdAt));
const contacts = await db.select().from(contactSubmissions).orderBy(desc(contactSubmissions.createdAt));

const pendingApps = applications.filter(a => a.status === 'pending').length;
const newContacts = contacts.filter(c => c.status === 'new').length;

function getWhatsAppUrl(phone: string): string {
  let digits = phone.replace(/[^0-9]/g, '');
  if (digits.startsWith('0') && digits.length === 11) {
    digits = '234' + digits.slice(1);
  }
  return `https://wa.me/${digits}`;
}
---
<BaseLayout title="Admin Dashboard | NasFon" noindex={true}>
    <header class="admin-nav">
        <div class="admin-nav-container">
            <div class="admin-brand">
                <a href="/" target="_blank" title="View live site">
                    <img src="/main-logo.svg" alt="NasFon" width="140" height="49">
                </a>
                <span class="admin-badge">Admin Portal</span>
            </div>
            <div class="admin-nav-actions">
                <span class="db-status-pill">
                    <span class="pulse-dot"></span>
                    Turso Edge DB
                </span>
                <a href="/" target="_blank" class="admin-link">Live Site ↗</a>
                <a href="/api/admin/logout" class="admin-logout-btn">Log Out</a>
            </div>
        </div>
    </header>

    <main class="admin-main">
        <!-- Stats Section -->
        <section class="admin-stats-grid">
            <div class="admin-stat-card">
                <div class="stat-icon-wrapper blue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </div>
                <div>
                    <span class="stat-count">{applications.length}</span>
                    <span class="stat-title">Project Applications</span>
                </div>
                {pendingApps > 0 && <span class="stat-tag alert">{pendingApps} Pending</span>}
            </div>

            <div class="admin-stat-card">
                <div class="stat-icon-wrapper purple">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div>
                    <span class="stat-count">{contacts.length}</span>
                    <span class="stat-title">Contact Inquiries</span>
                </div>
                {newContacts > 0 && <span class="stat-tag alert">{newContacts} New</span>}
            </div>

            <div class="admin-stat-card">
                <div class="stat-icon-wrapper green">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <div>
                    <span class="stat-count">{applications.length + contacts.length}</span>
                    <span class="stat-title">Total Submissions</span>
                </div>
                <span class="stat-tag success">Active</span>
            </div>
        </section>

        <!-- Controls: Tabs + Search & Filter -->
        <div class="admin-controls-bar">
            <div class="admin-tabs">
                <button class="tab-btn active" data-tab="applications">
                    Project Applications (<span id="app-counter">{applications.length}</span>)
                </button>
                <button class="tab-btn" data-tab="contacts">
                    Contact Messages (<span id="contact-counter">{contacts.length}</span>)
                </button>
            </div>

            <div class="search-filter-box">
                <div class="search-input-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" id="adminSearch" placeholder="Search by name, email, topic...">
                </div>
            </div>
        </div>

        <!-- Tab 1: Project Applications -->
        <section id="applications-tab" class="tab-content active">
            {applications.length === 0 ? (
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/></svg>
                    <h3>No project applications yet</h3>
                    <p>When clients submit project intake requests on <a href="/apply/" target="_blank">/apply/</a>, they will appear here in real time.</p>
                </div>
            ) : (
                <div class="items-list" id="appList">
                    {applications.map(app => (
                        <div class="submission-card" id={`card-application-${app.id}`} data-search={`${app.clientName} ${app.companyName || ''} ${app.email} ${app.serviceType} ${app.description}`.toLowerCase()} data-status={app.status}>
                            <div class="submission-header">
                                <div>
                                    <div class="submission-meta">
                                        <span class="client-name">{app.clientName}</span>
                                        {app.companyName && <span class="company-badge">{app.companyName}</span>}
                                        <span class="service-pill">{app.serviceType.replace('-', ' ')}</span>
                                        {app.budgetRange && <span class="budget-pill">{app.budgetRange}</span>}
                                        {app.timeline && <span class="timeline-pill">{app.timeline}</span>}
                                    </div>
                                    <div class="submission-subtext">
                                        Submitted {new Date(app.createdAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}
                                    </div>
                                </div>
                                <div class="status-action-box">
                                    <select
                                        class={`status-select ${app.status}`}
                                        onchange={`updateStatus('${app.id}', 'application', this.value)`}
                                    >
                                        <option value="pending" selected={app.status === 'pending'}>Pending Review</option>
                                        <option value="in_review" selected={app.status === 'in_review'}>In Review</option>
                                        <option value="accepted" selected={app.status === 'accepted'}>Accepted</option>
                                        <option value="declined" selected={app.status === 'declined'}>Declined</option>
                                    </select>
                                    <button
                                        class="delete-btn"
                                        title="Delete submission"
                                        onclick={`deleteSubmission('${app.id}', 'application')`}
                                    >
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                    </button>
                                </div>
                            </div>

                            <div class="submission-body">
                                <p class="description-text">{app.description}</p>
                            </div>

                            <div class="submission-footer">
                                <div class="contact-links">
                                    <a href={`mailto:${app.email}?subject=Regarding your project application with NasFon`} class="action-btn email">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                                        {app.email}
                                    </a>
                                    {app.phone && (
                                        <a href={getWhatsAppUrl(app.phone)} target="_blank" rel="noopener" class="action-btn phone">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                                            {app.phone} (WhatsApp)
                                        </a>
                                    )}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            )}
        </section>

        <!-- Tab 2: Contact Messages -->
        <section id="contacts-tab" class="tab-content">
            {contacts.length === 0 ? (
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/></svg>
                    <h3>No contact messages yet</h3>
                    <p>Inquiries submitted via the <a href="/contact/" target="_blank">/contact/</a> form will show up here.</p>
                </div>
            ) : (
                <div class="items-list" id="contactList">
                    {contacts.map(c => (
                        <div class="submission-card" id={`card-contact-${c.id}`} data-search={`${c.name} ${c.email} ${c.subject || ''} ${c.message}`.toLowerCase()} data-status={c.status}>
                            <div class="submission-header">
                                <div>
                                    <div class="submission-meta">
                                        <span class="client-name">{c.name}</span>
                                        {c.subject && <span class="subject-pill">{c.subject}</span>}
                                    </div>
                                    <div class="submission-subtext">
                                        Submitted {new Date(c.createdAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}
                                    </div>
                                </div>
                                <div class="status-action-box">
                                    <select
                                        class={`status-select ${c.status}`}
                                        onchange={`updateStatus('${c.id}', 'contact', this.value)`}
                                    >
                                        <option value="new" selected={c.status === 'new'}>New</option>
                                        <option value="reviewed" selected={c.status === 'reviewed'}>Reviewed</option>
                                        <option value="contacted" selected={c.status === 'contacted'}>Contacted</option>
                                        <option value="archived" selected={c.status === 'archived'}>Archived</option>
                                    </select>
                                    <button
                                        class="delete-btn"
                                        title="Delete message"
                                        onclick={`deleteSubmission('${c.id}', 'contact')`}
                                    >
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                    </button>
                                </div>
                            </div>

                            <div class="submission-body">
                                <p class="description-text">{c.message}</p>
                            </div>

                            <div class="submission-footer">
                                <div class="contact-links">
                                    <a href={`mailto:${c.email}?subject=${encodeURIComponent('Re: ' + (c.subject || 'Your Inquiry to NasFon'))}`} class="action-btn email">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                                        {c.email}
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            )}
        </section>
    </main>
</BaseLayout>

<style>
    .admin-nav {
        background: #ffffff;
        border-bottom: 1px solid var(--gray-300);
        padding: 16px 32px;
        position: sticky;
        top: 0;
        z-index: 100;
    }
    .admin-nav-container {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .admin-brand {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .admin-badge {
        background: var(--blue-light);
        color: var(--blue);
        font-size: 0.78rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .admin-nav-actions {
        display: flex;
        align-items: center;
        gap: 20px;
    }
    .db-status-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--gray-700);
        background: var(--gray-100);
        padding: 6px 12px;
        border-radius: 20px;
    }
    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    }
    .admin-link {
        font-size: 0.88rem;
        color: var(--gray-700);
        text-decoration: none;
        font-weight: 500;
    }
    .admin-logout-btn {
        background: var(--gray-100);
        color: var(--gray-900);
        font-size: 0.82rem;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s;
    }
    .admin-logout-btn:hover {
        background: #fee2e2;
        color: #b91c1c;
    }

    .admin-main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 32px 80px;
    }

    /* Stats Grid */
    .admin-stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 32px;
    }
    .admin-stat-card {
        background: #ffffff;
        border: 1px solid var(--gray-300);
        border-radius: 16px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
    }
    .stat-icon-wrapper {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .stat-icon-wrapper svg { width: 24px; height: 24px; }
    .stat-icon-wrapper.blue { background: #e8f1ff; color: var(--blue); }
    .stat-icon-wrapper.purple { background: #f3e8ff; color: #8b5cf6; }
    .stat-icon-wrapper.green { background: #dcfce7; color: #10b981; }

    .stat-count {
        display: block;
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--dark);
        line-height: 1.1;
    }
    .stat-title {
        font-size: 0.85rem;
        color: var(--gray-500);
        font-weight: 500;
    }
    .stat-tag {
        position: absolute;
        top: 20px;
        right: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 6px;
    }
    .stat-tag.alert { background: #fef3c7; color: #b45309; }
    .stat-tag.success { background: #ecfdf5; color: #047857; }

    /* Controls Bar */
    .admin-controls-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        border-bottom: 1.5px solid var(--gray-300);
        margin-bottom: 28px;
        padding-bottom: 4px;
    }
    .admin-tabs {
        display: flex;
        gap: 12px;
    }
    .tab-btn {
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        padding: 12px 18px;
        font-family: inherit;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--gray-500);
        cursor: pointer;
        transition: all 0.2s;
    }
    .tab-btn:hover { color: var(--blue); }
    .tab-btn.active {
        color: var(--blue);
        border-bottom-color: var(--blue);
    }
    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .search-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }
    .search-input-wrapper svg {
        position: absolute;
        left: 14px;
        width: 16px;
        height: 16px;
        color: var(--gray-500);
        pointer-events: none;
    }
    .search-input-wrapper input {
        padding: 10px 16px 10px 38px;
        border: 1.5px solid var(--gray-300);
        border-radius: 10px;
        font-family: inherit;
        font-size: 0.88rem;
        color: var(--dark);
        width: 280px;
        outline: none;
        transition: border-color 0.2s;
        background: #ffffff;
    }
    .search-input-wrapper input:focus {
        border-color: var(--blue);
        box-shadow: 0 0 0 3px var(--blue-glow);
    }

    /* List & Cards */
    .items-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .submission-card {
        background: #ffffff;
        border: 1px solid var(--gray-300);
        border-radius: 16px;
        padding: 24px;
        transition: box-shadow 0.2s, opacity 0.2s;
    }
    .submission-card:hover {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }
    .submission-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 16px;
    }
    .submission-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 4px;
    }
    .client-name {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--dark);
    }
    .company-badge {
        background: var(--gray-100);
        color: var(--gray-700);
        font-size: 0.8rem;
        padding: 2px 8px;
        border-radius: 6px;
        font-weight: 500;
    }
    .service-pill, .budget-pill, .timeline-pill, .subject-pill {
        font-size: 0.78rem;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        text-transform: capitalize;
    }
    .service-pill { background: #e8f1ff; color: var(--blue); }
    .budget-pill { background: #ecfdf5; color: #047857; }
    .timeline-pill { background: #fef3c7; color: #b45309; }
    .subject-pill { background: #f3e8ff; color: #7e22ce; }

    .submission-subtext {
        font-size: 0.8rem;
        color: var(--gray-500);
    }
    .status-action-box {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .status-select {
        padding: 6px 12px;
        border-radius: 8px;
        border: 1.5px solid var(--gray-300);
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        outline: none;
    }
    .status-select.pending, .status-select.new { background: #fef3c7; color: #92400e; border-color: #fde68a; }
    .status-select.in_review, .status-select.reviewed { background: #e0f2fe; color: #075985; border-color: #bae6fd; }
    .status-select.accepted, .status-select.contacted { background: #dcfce7; color: #166534; border-color: #bbf7d0; }
    .status-select.declined, .status-select.archived { background: #f3f4f6; color: #4b5563; border-color: #e5e7eb; }

    .delete-btn {
        background: transparent;
        border: 1px solid var(--gray-300);
        color: var(--gray-500);
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }
    .delete-btn svg { width: 15px; height: 15px; }
    .delete-btn:hover {
        background: #fee2e2;
        border-color: #fca5a5;
        color: #b91c1c;
    }

    .submission-body {
        margin-bottom: 20px;
    }
    .description-text {
        font-size: 0.95rem;
        color: var(--gray-700);
        line-height: 1.6;
        white-space: pre-wrap;
    }
    .submission-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 16px;
        border-top: 1px solid var(--gray-100);
    }
    .contact-links {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        padding: 6px 12px;
        border-radius: 8px;
        transition: all 0.2s;
    }
    .action-btn svg { width: 15px; height: 15px; }
    .action-btn.email {
        background: var(--blue-light);
        color: var(--blue);
    }
    .action-btn.email:hover {
        background: var(--blue);
        color: #fff;
    }
    .action-btn.phone {
        background: #dcfce7;
        color: #166534;
    }
    .action-btn.phone:hover {
        background: #16a34a;
        color: #fff;
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        background: #ffffff;
        border-radius: 16px;
        border: 1px dashed var(--gray-300);
    }
    .empty-state svg { width: 48px; height: 48px; color: var(--gray-500); margin-bottom: 16px; }
    .empty-state h3 { font-size: 1.15rem; color: var(--dark); margin-bottom: 8px; }
    .empty-state p { font-size: 0.9rem; color: var(--gray-500); }

    @media (max-width: 800px) {
        .admin-stats-grid { grid-template-columns: 1fr; }
        .submission-header { flex-direction: column; }
        .search-input-wrapper input { width: 100%; }
        .admin-controls-bar { flex-direction: column; align-items: stretch; }
    }
</style>

<script is:inline>
    // Tab switching
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            tabBtns.forEach(b => b.classList.remove('active'));
            tabContents.forEach(c => c.classList.remove('active'));

            btn.classList.add('active');
            const targetId = btn.getAttribute('data-tab') + '-tab';
            const targetTab = document.getElementById(targetId);
            if (targetTab) targetTab.classList.add('active');
        });
    });

    // Live search filter
    const searchInput = document.getElementById('adminSearch');
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase().trim();
            const activeTab = document.querySelector('.tab-content.active');
            if (!activeTab) return;

            const cards = activeTab.querySelectorAll('.submission-card');
            cards.forEach(card => {
                const text = card.getAttribute('data-search') || '';
                if (!query || text.includes(query)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    }

    // Update status
    async function updateStatus(id, type, status) {
        try {
            const res = await fetch('/api/admin/status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, type, status }),
            });
            if (res.ok) {
                window.location.reload();
            } else {
                alert('Failed to update status. Please try again.');
            }
        } catch (err) {
            alert('Network error while updating status.');
        }
    }
    window.updateStatus = updateStatus;

    // Delete submission
    async function deleteSubmission(id, type) {
        if (!confirm('Are you sure you want to permanently delete this submission? This action cannot be undone.')) {
            return;
        }

        try {
            const res = await fetch('/api/admin/status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, type, action: 'delete' }),
            });

            if (res.ok) {
                const card = document.getElementById(`card-${type}-${id}`);
                if (card) {
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.95)';
                    setTimeout(() => card.remove(), 250);
                }
            } else {
                alert('Failed to delete submission. Please try again.');
            }
        } catch (err) {
            alert('Network error while deleting submission.');
        }
    }
    window.deleteSubmission = deleteSubmission;
</script>
