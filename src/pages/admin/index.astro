---
import { db, ensureTablesCreated } from '../../db';
import { contactSubmissions, projectApplications } from '../../db/schema';
import { desc } from 'drizzle-orm';
import { isValidAdminSession } from '../../lib/auth';
import '../../styles/admin.css';

export const prerender = false;

// 1. Authenticate session
if (!isValidAdminSession(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

// 2. Fetch live data from Turso
await ensureTablesCreated();

const applications = await db.select().from(projectApplications).orderBy(desc(projectApplications.createdAt));
const contacts = await db.select().from(contactSubmissions).orderBy(desc(contactSubmissions.createdAt));

const pendingApps = applications.filter((a) => a.status === 'pending').length;
const newContacts = contacts.filter((c) => c.status === 'new').length;

// 3. Merge into a single inbox list for the master-detail UI
const submissions = [
  ...applications.map((a) => ({
    key: `application:${a.id}`,
    type: 'application',
    id: a.id,
    name: a.clientName,
    email: a.email,
    phone: a.phone || '',
    status: a.status,
    createdAt: new Date(a.createdAt).getTime(),
    companyName: a.companyName || '',
    serviceType: a.serviceType,
    budgetRange: a.budgetRange || '',
    timeline: a.timeline || '',
    body: a.description,
    subject: '',
  })),
  ...contacts.map((c) => ({
    key: `contact:${c.id}`,
    type: 'contact',
    id: c.id,
    name: c.name,
    email: c.email,
    phone: '',
    status: c.status,
    createdAt: new Date(c.createdAt).getTime(),
    companyName: '',
    serviceType: '',
    budgetRange: '',
    timeline: '',
    body: c.message,
    subject: c.subject || '',
  })),
].sort((x, y) => y.createdAt - x.createdAt);

const submissionsJson = JSON.stringify(submissions);
