    </main>

    <div class="toast-pill" id="toast"></div>

    <div id="submissions-data" data-json={submissionsJson} hidden></div>

    <script is:inline>
        const ITEMS = JSON.parse(document.getElementById('submissions-data').dataset.json);

        const listEl = document.getElementById('msg-list');
        const detailEmpty = document.getElementById('detail-empty');
        const detailActive = document.getElementById('detail-active');
        const searchInput = document.getElementById('search-input');
        const listCountText = document.getElementById('list-count-text');
        const colHeading = document.getElementById('col-heading');
        const breadcrumbCurrent = document.getElementById('breadcrumb-current');
        const appMain = document.getElementById('app-main');

        let typeFilter = 'all';
        let searchQuery = '';
        let selectedKey = null;

        function esc(s) {
            return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[c]));
        }

        function initials(name) {
            const parts = String(name || '').trim().split(/\s+/).filter(Boolean);
            const chars = parts.map((w) => w[0]).join('').slice(0, 2).toUpperCase();
            return chars || 'N';
        }

        function fmtTime(ts) {
            return new Date(ts).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });
        }

        function waUrl(phone) {
            let digits = String(phone || '').replace(/[^0-9]/g, '');
            if (digits.startsWith('0') && digits.length === 11) digits = '234' + digits.slice(1);
            return digits ? `https://wa.me/${digits}` : '';
        }

        function filtered() {
            let list = ITEMS.slice();
            if (typeFilter !== 'all') list = list.filter((s) => s.type === typeFilter);
            if (searchQuery) {
                const q = searchQuery.toLowerCase();
                list = list.filter((s) => `${s.name} ${s.email} ${s.body} ${s.subject} ${s.serviceType} ${s.companyName}`.toLowerCase().includes(q));
            }
            return list;
        }

        function typeLabel(type) {
            return type === 'application' ? 'Application' : 'Contact';
        }

        function serviceLabel(s) {
            return s ? s.replace(/-/g, ' ') : '';
        }

        function renderList() {
            const list = filtered();
            listCountText.textContent = list.length;
            listEl.innerHTML = '';

            if (list.length === 0) {
                listEl.innerHTML = `<li style="padding:24px 16px;text-align:center;color:#9ca3af;font-size:13px;">No submissions yet</li>`;
                return;
            }

            list.forEach((item) => {
                const row = document.createElement('li');
                row.className = 'msg-row' + (item.key === selectedKey ? ' selected' : '');
                row.setAttribute('role', 'option');
                row.setAttribute('aria-selected', item.key === selectedKey ? 'true' : 'false');
                row.innerHTML = `
                    <div class="msg-avatar">${esc(initials(item.name))}</div>
                    <div class="msg-info">
                        <div class="msg-name">${esc(item.name)}</div>
                        <div class="msg-snippet">${esc(item.body || item.subject)}</div>
                    </div>
                    <div class="msg-meta">
                        <span class="msg-time">${esc(fmtTime(item.createdAt))}</span>
                        <span class="msg-badge ${item.type}">${esc(typeLabel(item.type))}</span>
                    </div>
                `;
                row.addEventListener('click', () => selectItem(item.key));
                listEl.appendChild(row);
            });
        }

        function statusOptions(item) {
            const options = item.type === 'application'
                ? [['pending', 'Pending Review'], ['in_review', 'In Review'], ['accepted', 'Accepted'], ['declined', 'Declined']]
                : [['new', 'New'], ['reviewed', 'Reviewed'], ['contacted', 'Contacted'], ['archived', 'Archived']];
            return options.map(([val, label]) =>
                `<option value="${val}" ${item.status === val ? 'selected' : ''}>${label}</option>`
            ).join('');
        }

        function metaItems(item) {
            const items = [];
            if (item.type === 'application') {
                items.push(['Service Type', serviceLabel(item.serviceType)]);
                if (item.budgetRange) items.push(['Budget', item.budgetRange]);
                if (item.timeline) items.push(['Timeline', item.timeline]);
                if (item.companyName) items.push(['Company', item.companyName]);
            } else {
                if (item.subject) items.push(['Subject', item.subject]);
            }
            items.push(['Received', fmtTime(item.createdAt)]);
            return items;
        }

        function renderDetail(item) {
            detailEmpty.style.display = 'none';
            detailActive.classList.add('active');

            const emailHref = item.type === 'application'
                ? `mailto:${esc(item.email)}?subject=${encodeURIComponent('Regarding your project application with NasFon')}`
                : `mailto:${esc(item.email)}?subject=${encodeURIComponent('Re: ' + (item.subject || 'Your Inquiry to NasFon'))}`;
            const waHref = waUrl(item.phone);

            const metaHtml = metaItems(item).map(([label, value]) => `
                <div class="meta-item">
                    <span class="meta-label">${esc(label)}</span>
                    <span class="meta-value">${esc(value)}</span>
                </div>
            `).join('');

            const contactsHtml = [
                `<a href="${emailHref}">${esc(item.email)}</a>`,
                item.phone ? `<a href="${waHref}" target="_blank" rel="noopener noreferrer">${esc(item.phone)}</a>` : '',
            ].filter(Boolean).join('<span>•</span>');

            detailActive.innerHTML = `
                <div class="detail-header">
                    <div class="detail-header-left">
                        <button type="button" class="mobile-back-btn" id="btn-mobile-back" aria-label="Back to list">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
                            <span>Back</span>
                        </button>
                        <div class="detail-sender">
                            <div class="detail-avatar">${esc(initials(item.name))}</div>
                            <div class="detail-title-group">
                                <h3>${esc(item.name)}</h3>
                                <div class="detail-contacts">${contactsHtml}</div>
                            </div>
                        </div>
                    </div>
                    <div class="detail-actions">
                        <select class="status-select ${esc(item.status)}" id="status-select">
                            ${statusOptions(item)}
                        </select>
                        <button class="action-btn danger" id="btn-delete">
                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                            <span>Delete</span>
                        </button>
                    </div>
                </div>
                <div class="detail-body">
                    <div class="detail-card">
                        <div class="card-meta-grid">${metaHtml}</div>
                        <div class="message-content-title">${item.type === 'application' ? 'Project Description' : 'Message'}</div>
                        <div class="message-text">${esc(item.body)}</div>
                        <div class="quick-replies">
                            ${waHref ? `<a href="${waHref}" target="_blank" rel="noopener noreferrer" class="btn-contact whatsapp-direct">
                                <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.668-.699c.969.539 1.947.82 2.792.82 3.182 0 5.768-2.587 5.769-5.766.001-3.181-2.586-5.766-5.769-5.766zm9.969 5.766c0 5.518-4.482 10-10 10-1.748 0-3.385-.453-4.819-1.246l-5.181 1.355 1.378-5.034c-.878-1.488-1.378-3.224-1.378-5.075 0-5.518 4.482-10 10-10s10 4.482 10 10z"/></svg>
                                <span>Chat on WhatsApp</span>
                            </a>` : ''}
                            <a href="${emailHref}" class="btn-contact email-direct">
                                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                                <span>Send Email</span>
                            </a>
                        </div>
                    </div>

                    <div class="reply-card">
                        <div class="message-content-title" style="margin-bottom:8px;">Quick Reply to Client</div>
                        <textarea id="reply-text" placeholder="Type response here (e.g. Thanks for reaching out! Let's schedule a 15-minute call...)"></textarea>
                        <div class="reply-actions">
                            <button class="action-btn" id="btn-copy-reply">Copy reply</button>
                            ${waHref ? `<button class="action-btn btn-primary" id="btn-send-wa">Send via WhatsApp</button>` : ''}
                        </div>
                    </div>
                </div>
            `;

            document.getElementById('status-select').addEventListener('change', (e) => updateStatus(item, e.target.value));
            document.getElementById('btn-delete').addEventListener('click', () => deleteSubmission(item));
            document.getElementById('btn-mobile-back').addEventListener('click', closeMobileDetail);
            document.getElementById('btn-copy-reply').addEventListener('click', copyReply);
            const sendWa = document.getElementById('btn-send-wa');
            if (sendWa) sendWa.addEventListener('click', () => sendWhatsApp(item));
        }

        function selectItem(key) {
            selectedKey = key;
            const item = ITEMS.find((s) => s.key === key);
            if (!item) return;
            renderDetail(item);
            renderList();
            if (window.matchMedia('(max-width: 768px)').matches) {
                appMain.classList.add('mobile-detail-open');
            }
        }

        function closeMobileDetail() {
            appMain.classList.remove('mobile-detail-open');
        }

        function copyReply() {
            const textarea = document.getElementById('reply-text');
            if (!textarea) return;
            navigator.clipboard.writeText(textarea.value).then(() => showToast('Reply copied'));
        }

        function sendWhatsApp(item) {
            const textarea = document.getElementById('reply-text');
            const text = textarea ? textarea.value : '';
            const base = waUrl(item.phone);
            const url = base + (text ? `?text=${encodeURIComponent(text)}` : '');
            window.open(url, '_blank', 'noopener');
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.style.display = 'block';
            clearTimeout(showToast._t);
            showToast._t = setTimeout(() => { toast.style.display = 'none'; }, 2000);
        }

        async function updateStatus(item, status) {
            try {
                const res = await fetch('/api/admin/status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: item.id, type: item.type, status }),
                });
                if (res.ok) {
                    window.location.reload();
                } else {
                    showToast('Failed to update status');
                }
            } catch (err) {
                showToast('Network error');
            }
        }

        async function deleteSubmission(item) {
            if (!confirm('Are you sure you want to permanently delete this submission? This action cannot be undone.')) return;
            try {
                const res = await fetch('/api/admin/status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: item.id, type: item.type, action: 'delete' }),
                });
                if (res.ok) {
                    window.location.reload();
                } else {
                    showToast('Failed to delete');
                }
            } catch (err) {
                showToast('Network error');
            }
        }

        const VIEW_TITLES = {
            'hero-stats': 'Hero & Stats',
            'tech-stack': 'Tech Stack',
            'about': 'About',
            'projects': 'Projects',
            'classes': 'Classes',
            'source-code': 'Source code',
            'ebooks': 'E-books',
            'contact-support': 'Contact & Support',
            'payments': 'Payments',
            'assistant': 'Assistant',
            'team': 'Team',
            'settings': 'Site settings',
            'social': 'Social links',
            'visibility': 'Public visibility',
            'audit-log': 'Change log',
            'security': 'Security'
        };

        function setView(view) {
            document.querySelectorAll('.nav-item[data-view]').forEach((n) => {
                n.classList.toggle('active', n.getAttribute('data-view') === view);
            });

            const dashboardView = document.getElementById('view-dashboard');
            const emptyView = document.getElementById('view-empty');

            if (view === 'dashboard') {
                appMain.classList.add('show-dashboard');
                dashboardView.classList.add('active');
                emptyView.classList.remove('active');
                breadcrumbCurrent.textContent = 'Dashboard';
                return;
            }

            if (VIEW_TITLES[view]) {
                appMain.classList.add('show-dashboard');
                dashboardView.classList.remove('active');
                emptyView.classList.add('active');
                document.getElementById('empty-view-title').textContent = VIEW_TITLES[view];
                breadcrumbCurrent.textContent = VIEW_TITLES[view];
                return;
            }

            appMain.classList.remove('show-dashboard');
            dashboardView.classList.remove('active');
            emptyView.classList.remove('active');
            typeFilter = view === 'contacts' ? 'contact' : view === 'applications' ? 'application' : 'all';
            document.querySelectorAll('.pill-btn[data-type]').forEach((p) => {
                p.classList.toggle('active', p.getAttribute('data-type') === typeFilter);
            });
            colHeading.textContent = view === 'contacts' ? 'Contacts' : view === 'applications' ? 'Applications' : 'Inbox';
            breadcrumbCurrent.textContent = colHeading.textContent;
            selectedKey = null;
            detailActive.classList.remove('active');
            detailEmpty.style.display = 'flex';
            renderList();
        }

        // Sidebar navigation
        document.querySelectorAll('.nav-item[data-view]').forEach((n) => {
            n.addEventListener('click', () => setView(n.getAttribute('data-view')));
        });

        // Filter pills
        document.querySelectorAll('.pill-btn[data-type]').forEach((p) => {
            p.addEventListener('click', () => {
                typeFilter = p.getAttribute('data-type');
                document.querySelectorAll('.pill-btn[data-type]').forEach((x) => x.classList.toggle('active', x === p));
                if (typeFilter === 'all') {
                    colHeading.textContent = 'Inbox';
                } else {
                    colHeading.textContent = typeFilter === 'application' ? 'Applications' : 'Contacts';
                    const navView = typeFilter === 'application' ? 'applications' : 'contacts';
                    document.querySelectorAll('.nav-item[data-view]').forEach((n) => {
                        n.classList.toggle('active', n.getAttribute('data-view') === navView);
                    });
                    appMain.classList.remove('show-dashboard');
                }
                breadcrumbCurrent.textContent = colHeading.textContent;
                selectedKey = null;
                detailActive.classList.remove('active');
                detailEmpty.style.display = 'flex';
                renderList();
            });
        });

        // Search
        searchInput.addEventListener('input', (e) => {
            searchQuery = e.target.value.trim();
            renderList();
        });

        // Mobile sidebar toggle
        const sidebar = document.getElementById('app-sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        const menuBtn = document.getElementById('mobile-menu-btn');

        function setSidebarOpen(open) {
            sidebar.classList.toggle('open', open);
            backdrop.classList.toggle('open', open);
            menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        menuBtn.addEventListener('click', () => setSidebarOpen(!sidebar.classList.contains('open')));
        backdrop.addEventListener('click', () => setSidebarOpen(false));

        // Initial render
        setView('applications');
    </script>
</body>
</html>
